{% extends "views/layouts/main.njk" %}

{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "views/layouts/components/search-bar.njk" import searchBar %}
{% from "views/layouts/components/filter-accordion.njk" import filterAccordion %}

{% import "views/pagination/pagination-options.njk" as paginationOptions %}

{% block pageTitle %}
    Case list - All Cases - Manage a Case
{% endblock %}

{% block pageContent %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-third">
            {{ filterAccordion(filters, currentPath, searchValue, cspNonce) }}
        </div>
        <div class="govuk-grid-column-two-thirds">
            <form id="search-bar-form" method="GET">
                {# Ensure active filters are preserved when searching #}
                {% for groups in filters.checkboxGroups %}
                    {% for group in groups %}
                        {% for item in group.items %}
                            {% if item.checked %}
                                <input type="hidden" name="{{ group.name }}" value="{{ item.value }}">
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                {% endfor %}
                {{ searchBar({
                    input: {
                        label: {
                            text: "Search cases"
                        },
                        hint: {
                            text: "To find a specific case, search by reference, historical reference, case name, applicant or local authority."
                        },
                        classes: "govuk-input govuk-input--width-30"
                    },
                    clearLink: clearSearchUrl if searchValue,
                    button: {
                        text: "Search",
                        classes: "govuk-button"
                    }
                }, searchValue) }}
            </form>
            <div id="pagination">
                <p class="govuk-body govuk-clearfix">
                    <span>
                        Showing <strong>{{ paginationParams.resultsStartNumber }}</strong> to <strong>{{ paginationParams.resultsEndNumber if paginationParams.totalCases > paginationParams.resultsEndNumber else paginationParams.totalCases }}</strong>
                        of <strong>{{ paginationParams.totalCases }}</strong> results
                    </span>
                    <span class="pins-pagination-options">
                        {{ paginationOptions.renderPagination(paginationParams.selectedItemsPerPage, paginationParams.totalCases, paginationParams.pageNumber, searchValue, paginationParams.filtersValue, paginationParams.sortValue) }}
                    </span>
                </p>

                {% if cases|length == 0 %}
                    <p class="govuk-body">No results were found.</p>
                    {% if searchValue %}
                        <p class="govuk-body"><a href="{{ clearSearchUrl }}" class="govuk-link govuk-link--no-visited-state">Clear search</a> to view {{ "cases matching your filters" if filters.selectedCategories.categories.length > 0 else "all cases" }}.</p>
                    {% elif filters.selectedCategories.categories.length > 0 %}
                        <p class="govuk-body"><a href="{{ filters.selectedCategories.clearLinkHref }}" class="govuk-link govuk-link--no-visited-state">Clear filters</a> to view all cases.</p>
                    {% endif %}
                {% else %}
                    {{ casesTable(cases) }}
                {% endif %}
            </div>

            {# if uiItems.items is <=1 then pagination options not shown #} 
            {% if paginationParams.uiItems.items.length > 1 %}
                {{ govukPagination(paginationParams.uiItems) }}
            {% endif %}
        </div>
    </div>

{% endblock %}

{% macro casesTable(caseRows) %}
    {% set cases = [] %}

    {% for case in caseRows %}
        {% set cases = (cases.push([
            {
                html: "<a class='govuk-link' target='_blank' href='/cases/" +  case.id +"'>" + case.reference + "</a>"
            },
            {
                text: case.name
            },
            {
                text: case.receivedDate
            },
            {
                text: case.Status.displayName
            }
        ]), cases) %}
    {% endfor %}

    {{ govukTable({
        head: sortHeaders,
        rows: cases
    }) }}
{% endmacro %}