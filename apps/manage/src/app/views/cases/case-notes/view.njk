{% extends "views/layouts/main.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% set title = reference + " - Case history" %}

{% block pageTitle %}
    {{ title }}
{% endblock %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <h2 class="govuk-caption-l" data-cy="page-caption">
                {{ reference }}
            </h2>
            <h1 class="govuk-heading-l" data-cy="page-heading">
                {{ pageHeading }}
            </h1>

            {% if caseNotes | length == 0 %}
                <p class="govuk-body" data-cy="no-notes-message">There are no case notes to display</p>
            {% else %}
                {% set tableRows = [] %}
                {% for note in caseNotes %}
                    {% set actionHtml %}
                        <ul class="govuk-list">
                            <li>
                                <a class="govuk-link govuk-link--no-visited-state" href="{{ currentUrl }}/{{ note.id }}/edit" data-cy="change-note-link-{{ loop.index0 }}">
                                    Change<span class="govuk-visually-hidden"> case note by {{ note.userName }}</span>
                                </a>
                            </li>
                            <li>
                                <a class="govuk-link govuk-link--no-visited-state" href="{{ currentUrl }}/{{ note.id }}/delete" data-cy="remove-note-link-{{ loop.index0 }}">
                                    Remove<span class="govuk-visually-hidden"> case note by {{ note.userName }}</span>
                                </a>
                            </li>
                        </ul>
                    {% endset %}
                    {% set tableRows = (tableRows.push([
                        {
                            html: note.date + "<br>" + note.time + ("" if not note.changedDate else "<br>(Changed " + note.changedDate + ")"),
                            attributes: { "data-cy": "note-date-" + loop.index0 }
                        },
                        {
                            html: note.commentText,
                            attributes: { "data-cy": "note-comment-" + loop.index0 },
                            classes: "govuk-!-text-break-word"
                        },
                        {
                            text: note.userName,
                            attributes: { "data-cy": "note-user-" + loop.index0 }
                        },
                        {
                            html: actionHtml,
                            attributes: { "data-cy": "note-actions-" + loop.index0 }
                        }
                    ]), tableRows) %}
                {% endfor %}

                {{ govukTable({
                    attributes: {
                        "data-cy": "case-notes-table"
                    },
                    head: [
                        { text: "Date and time", classes: "govuk-!-width-one-quarter" },
                        { text: "Details" },
                        { text: "User", classes: "govuk-!-width-one-quarter" },
                        { text: "Actions" }
                    ],
                    rows: tableRows
                }) }}
            {% endif %}
        </div>
    </div>
{% endblock %}