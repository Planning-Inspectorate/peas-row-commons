{% extends layoutTemplate %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% block dynQuestionContent %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <form action="" method="post" novalidate>
                {% if _csrf %}<input type="hidden" name="_csrf" value="{{ _csrf }}">{% endif %}
                <h1 class="govuk-heading-l">Remove {{ titleSingular | lower }}</h1>

                <div class="govuk-inset-text">
                    {% for item in questionSummary %}
                        {% if item.answer %}
                            <p class="govuk-body">{{ item.answer | safe }}</p>
                        {% endif %}
                    {% endfor %}
                </div>

                {{ govukButton({
                    text: "Remove " + (titleSingular | lower),
                    type: "submit",
                    classes: "govuk-button--warning",
                    attributes: {
                        name: "remove",
                        value: "remove",
                        "data-cy":"button-remove"
                    }
                }) }}

                {{ govukButton({
                    text: "Cancel",
                    href: backLink,
                    classes: "govuk-button--secondary",
                    attributes: { "data-cy":"button-back"}
                }) }}
            </form>
        </div>
    </div>
{% endblock %}